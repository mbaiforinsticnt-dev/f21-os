<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged-permission allowlist for F21 OS apps injected into the system image.
  Installed to /system/etc/permissions/ by rom/scripts/inject-f21-apps.sh.
  The launcher runs as a priv-app so it can apply the default-IME setup
  (WRITE_SECURE_SETTINGS) on first boot and self-heal it on later boots.
-->
<permissions>
    <privapp-permissions package="dev.mbaiforinstinct.f21os">
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>
</permissions>
